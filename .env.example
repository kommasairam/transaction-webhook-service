# Copy this file to `.env` and fill in DATABASE_URL.
# `npm run dev` and `npm start` load `.env` automatically (Node's --env-file-if-exists).
# On a hosting platform (Render/Railway) set these as environment variables instead;
# no .env file is needed there. NEVER commit .env.

# --- Required -----------------------------------------------------------------
# Postgres connection string (Neon / Supabase / any Postgres).
# Neon: use the pooled host (contains "-pooler") and keep only sslmode=require.
# Do not include channel_binding=require (not supported by the `pg` driver).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Optional (defaults shown) --------------------------------------------------
# PORT=3000                    # HTTP port (hosting platforms usually inject this)
# PROCESSING_DELAY_MS=30000    # simulated external API latency per transaction
# POLL_INTERVAL_MS=1000        # how often the worker looks for pending transactions
# WORKER_CONCURRENCY=200       # max transactions processed in parallel per instance
# LEASE_MS=120000              # a claimed row older than this is treated as abandoned and retried
# MAX_ATTEMPTS=5               # after this many failed attempts a transaction is marked FAILED
